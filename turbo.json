{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_GA_MEASUREMENT_ID", "NEXT_PUBLIC_GA_DEBUG_MODE"],
      "cache": true
    },
    "lint": {
      "cache": true
    }
  }
}
